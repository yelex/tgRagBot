# Telegram Bot Token (получить у @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# GigaChat Authorization Key (получить в личном кабинете Сбера)
AUTHORIZATION_KEY=your_gigachat_authorization_key_here

# MySQL настройки (можно не менять)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=flower_bot
MYSQL_USER=flower_user
MYSQL_PASSWORD=flower_password
MYSQL_PORT=3307